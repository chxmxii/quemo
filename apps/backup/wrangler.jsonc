{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quemo-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every Monday at 02:30 UTC.
  "triggers": { "crons": ["30 2 * * 1"] },
  "vars": {
    // Set by `node scripts/deploy.mjs backup` from deploy.config.json.
    "BACKUP_REPO": "",
    "AGE_RECIPIENT": ""
  },
  // Secrets: GITHUB_TOKEN (fine-grained, Contents read/write on BACKUP_REPO only), RUN_TOKEN (optional manual trigger).
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "quemo-auth", "database_id": "5222d77c-449c-42e7-b0c5-5c69fcbff969" },
    { "binding": "BUDGET_DB", "database_name": "quemo-budget", "database_id": "38689840-c871-4825-9690-c9efebbf0219" },
    { "binding": "WORKOUT_DB", "database_name": "quemo-workout", "database_id": "b346c92d-256f-473f-b600-05126ab9038f" },
    { "binding": "HEALTH_DB", "database_name": "quemo-health", "database_id": "721fd422-e32c-478a-88bd-35a3b6a0c214" },
    { "binding": "FOOD_DB", "database_name": "quemo-food", "database_id": "58e38e20-2b03-411d-a479-848353a01184" }
  ]
}
