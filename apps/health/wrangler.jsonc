{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quemo-health",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_URL": "http://localhost:8790",
    "AUTH_URL": "http://localhost:8787"
  },
  "services": [{ "binding": "AUTH", "service": "quemo-auth" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "quemo-health", "database_id": "721fd422-e32c-478a-88bd-35a3b6a0c214", "migrations_dir": "migrations" }
  ],
  // Daily purge of data belonging to deleted accounts.
  "triggers": { "crons": ["17 3 * * *"] }
}
